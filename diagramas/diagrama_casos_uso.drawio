        <mxCell id="note_prod" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#666666;fontSize=9;align=left;verticalAlign=middle;spacingLeft=5;" value="&lt;b&gt;Fluxo interno (RF-063/064/065/066/067):&lt;/b&gt;&lt;br&gt;1. Visualizar fila com itens e personalizações&lt;br&gt;2. Iniciar preparo → status &quot;Em preparação&quot;&lt;br&gt;3. Marcar como Pronto → status &quot;Pronto&quot;&lt;br&gt;4. Pedidos com tempo excedido são destacados automaticamente&lt;br&gt;5. Sistema registra tempo total de preparação" vertex="1">
          <mxGeometry height="118" width="390" x="940" y="435" as="geometry" />
        </mxCell>
        <mxCell id="note_rn039" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff0d0;strokeColor=#e0a020;fontSize=9;align=left;verticalAlign=middle;spacingLeft=5;" value="&lt;b&gt;{RN-027/039}:&lt;/b&gt; status Pronto só após Em preparação. Pedidos além do tempo esperado são identificados como atrasados." vertex="1">
